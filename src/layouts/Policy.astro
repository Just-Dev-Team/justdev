---
// Layout for standalone Markdown pages (e.g. the Garmin Connect IQ privacy policy).
import Base from './Base.astro';

interface Props {
  frontmatter: { title: string; description: string };
}

const { frontmatter } = Astro.props;
---

<Base locale="en" title={frontmatter.title} description={frontmatter.description}>
  <div class="wrap page">
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }
</style>
