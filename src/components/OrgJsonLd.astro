---
import { company } from '../site';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  description: string;
}

const { locale, description } = Astro.props;
const site = Astro.site!;
const data = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  alternateName: company.brand,
  url: new URL(locale === 'pl' ? '/' : '/en/', site).href,
  logo: new URL('/apple-touch-icon.png', site).href,
  description,
  email: company.email,
  telephone: company.phoneHref,
  foundingDate: String(company.foundingYear),
  founder: { '@type': 'Person', name: company.owner },
  taxID: company.nip,
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'NIP', value: company.nip },
    { '@type': 'PropertyValue', propertyID: 'REGON', value: company.regon },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.postalCode,
    addressLocality: company.city,
    addressRegion: company.region,
    addressCountry: company.countryCode,
  },
  knowsLanguage: ['pl', 'en'],
  ...(company.sameAs.length > 0 ? { sameAs: company.sameAs } : {}),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
