---
// Decorative schematic of a scalable backend. Purely visual — hidden from assistive tech.
interface Props {
  caption: string;
}

const { caption } = Astro.props;
const services = [
  { x: 16, label: 'api' },
  { x: 146, label: 'workers' },
  { x: 276, label: 'events' },
];
---

<figure class="diagram">
  <svg viewBox="0 0 392 400" role="presentation" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="dots" width="16" height="16" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" fill="var(--line-strong)"></circle>
      </pattern>
    </defs>
    <rect width="392" height="400" fill="url(#dots)" opacity="0.55"></rect>

    <!-- connectors -->
    <g class="wires" fill="none" stroke="var(--line-strong)" stroke-width="1.25">
      <path d="M196 52V88"></path>
      <path d="M196 128v18H66v28"></path>
      <path d="M196 128v46"></path>
      <path d="M196 128v18h130v28"></path>
      <path d="M66 218v24h50v30"></path>
      <path d="M196 218v24h-80v30"></path>
      <path d="M196 218v24h80v30"></path>
      <path d="M326 218v24h-50v30"></path>
    </g>
    <g class="flow" fill="none" stroke="var(--accent)" stroke-width="1.5">
      <path d="M196 52V88"></path>
      <path d="M196 128v46"></path>
      <path d="M196 128v18H66v28" style="animation-delay:-0.4s"></path>
      <path d="M196 128v18h130v28" style="animation-delay:-0.8s"></path>
      <path d="M196 218v24h80v30" style="animation-delay:-0.2s"></path>
      <path d="M66 218v24h50v30" style="animation-delay:-0.6s"></path>
    </g>

    <!-- nodes -->
    <g class="node">
      <rect x="126" y="12" width="140" height="40" rx="5"></rect>
      <text x="196" y="37">clients</text>
    </g>
    <g class="node node--accent">
      <rect x="96" y="88" width="200" height="40" rx="5"></rect>
      <text x="196" y="113">edge · load balancer</text>
    </g>
    {
      services.map((s) => (
        <g class="node">
          <rect x={s.x + 5} y="179" width="100" height="44" rx="5" class="stack" />
          <rect x={s.x} y="174" width="100" height="44" rx="5" />
          <text x={s.x + 50} y="201">{s.label}</text>
        </g>
      ))
    }
    <g class="node">
      <rect x="46" y="272" width="140" height="40" rx="5"></rect>
      <text x="116" y="297">queue</text>
    </g>
    <g class="node">
      <rect x="206" y="272" width="140" height="40" rx="5"></rect>
      <text x="276" y="297">database</text>
    </g>
    <g class="node node--dashed">
      <rect x="16" y="340" width="360" height="40" rx="5"></rect>
      <text x="196" y="365">metrics · logs · traces · alerts</text>
    </g>
  </svg>
  <figcaption class="mono">{caption}</figcaption>
</figure>

<style>
  .diagram {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: linear-gradient(180deg, var(--bg-raised), var(--bg));
  }

  svg {
    width: 100%;
    height: auto;
  }

  .node rect {
    fill: var(--bg-raised);
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }

  .node rect.stack {
    fill: none;
    stroke-dasharray: 2 3;
    opacity: 0.8;
  }

  .node text {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    text-anchor: middle;
  }

  .node--accent rect {
    stroke: var(--accent);
    fill: var(--accent-soft);
  }

  .node--dashed rect {
    stroke-dasharray: 4 4;
    fill: none;
  }

  .node--dashed text {
    fill: var(--text-muted);
  }

  .flow path {
    stroke-dasharray: 3 11;
    animation: flow 1.4s linear infinite;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -28;
    }
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--text-faint);
  }
</style>
