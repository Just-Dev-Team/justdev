---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import OrgJsonLd from '../components/OrgJsonLd.astro';
import { t } from '../i18n';

const locale = 'pl';
const d = t(locale);
---

<Base locale={locale} title={d.meta.homeTitle} description={d.meta.homeDescription} alternates={{ pl: '/', en: '/en/' }}>
  <OrgJsonLd slot="head" locale={locale} description={d.meta.homeDescription} />
  <Home locale={locale} />
</Base>
