---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import type { Locale } from '../i18n';

const titles: Record<Locale, string> = {
  pl: '404 — Nie znaleziono strony — JustDev',
  en: '404 — Page not found — JustDev',
  de: '404 — Seite nicht gefunden — JustDev',
  fr: '404 — Page introuvable — JustDev',
};
---

<Base
  locale="pl"
  title={titles.pl}
  description="Nie znaleziono strony. Page not found. Seite nicht gefunden. Page introuvable."
  noindex
  bare
>
  <script define:vars={{ titles }}>
    // GitHub Pages serves this one file for every missing URL, so pick the
    // title and document language from the URL's locale prefix (/en/, /de/, /fr/).
    const match = location.pathname.match(/^\/(en|de|fr)\//);
    if (match) {
      document.title = titles[match[1]];
      document.documentElement.lang = match[1];
    }
  </script>
  <div class="wrap nf">
    <a class="brand" href="/" aria-label="JustDev — strona główna"><Logo /></a>
    <p class="code mono" aria-hidden="true">404</p>
    <div class="cols">
      <section aria-labelledby="nf-pl">
        <h1 id="nf-pl">Nie znaleziono strony</h1>
        <p>Strona, której szukasz, nie istnieje lub została przeniesiona.</p>
        <p><a class="btn btn--primary" href="/">Strona główna</a></p>
      </section>
      <section lang="en" aria-labelledby="nf-en">
        <h2 id="nf-en">Page not found</h2>
        <p>The page you are looking for does not exist or has been moved.</p>
        <p><a class="btn" href="/en/">English homepage</a></p>
      </section>
      <section lang="de" aria-labelledby="nf-de">
        <h2 id="nf-de">Seite nicht gefunden</h2>
        <p>Die gesuchte Seite existiert nicht oder wurde verschoben.</p>
        <p><a class="btn" href="/de/">Deutsche Startseite</a></p>
      </section>
      <section lang="fr" aria-labelledby="nf-fr">
        <h2 id="nf-fr">Page introuvable</h2>
        <p>La page que vous cherchez n’existe pas ou a été déplacée.</p>
        <p><a class="btn" href="/fr/">Accueil en français</a></p>
      </section>
    </div>
  </div>
</Base>

<style>
  .nf {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    align-content: center;
    gap: 2rem;
    padding-block: 3rem;
  }

  .brand {
    text-decoration: none;
    justify-self: start;
  }

  .code {
    font-size: clamp(5rem, 22vw, 11rem);
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.04em;
  }

  .cols {
    display: grid;
    gap: 2.5rem;
  }

  section {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  h1,
  h2 {
    font-size: 1.75rem;
  }

  section p:not(:last-child) {
    color: var(--text-muted);
  }

  @media (min-width: 48rem) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
